# PackSure AI Environment Configuration
# ======================================

# Backend API base URL
# Defines the location of the running PackSure backend service (e.g., local FastAPI server).
# Set to an empty string (or leave blank) for same-origin deployment.
VITE_API_BASE_URL=http://localhost:8000

# Mock Mode Configuration
# Controls whether the frontend uses mock simulation data or live backend calls.
# - Set to 'false' for live API mode (calls GET /health and POST /scan).
# - Set to 'true' only to explicitly enable offline mock fallback testing.
# IMPORTANT: Mock mode must NEVER silently become the production default.
VITE_USE_MOCK_API=false

# Optional server-side API key for container Gemini proxy (if used by server.ts)
GEMINI_API_KEY=
